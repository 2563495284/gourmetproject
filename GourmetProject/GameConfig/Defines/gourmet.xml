<module name="">
    <!--
        美食构筑肉鸽玩法配置。
        枚举值在 JSON 数据里用名字字符串书写（如 "Inherent"）。
        菜品形状用字符行表示：'X'/'1' 为占用格，其它字符为空，行从上到下、列从左到右。
    -->

    <enum name="TagCategory">
        <var name="Inherent" value="0"/>
        <var name="UniqueA" value="1"/>
        <var name="UniqueB" value="2"/>
    </enum>

    <enum name="TagEffectType">
        <var name="None" value="0"/>
        <var name="AddFlat" value="1"/>
        <var name="AddMult" value="2"/>
        <var name="PerAdjacentDish" value="3"/>
        <var name="PerEmptyCell" value="4"/>
        <var name="PerOccupiedCell" value="5"/>
        <var name="PerDishOnBoard" value="6"/>
    </enum>

    <enum name="ItemKind">
        <var name="Passive" value="0"/>
        <var name="Active" value="1"/>
    </enum>

    <enum name="ItemQuality">
        <var name="Common" value="0"/>
        <var name="Uncommon" value="1"/>
        <var name="Rare" value="2"/>
        <var name="Epic" value="3"/>
        <var name="Legendary" value="4"/>
    </enum>

    <enum name="ItemTriggerTiming">
        <var name="None" value="0"/>
        <var name="BeforeServe" value="1"/>
        <var name="AfterServe" value="2"/>
        <var name="BeforeEat" value="3"/>
        <var name="AfterSettlement" value="4"/>
        <var name="RewardScreen" value="5"/>
    </enum>

    <enum name="RewardKind">
        <var name="Gold" value="0"/>
        <var name="DishChoice" value="1"/>
        <var name="PassiveItemChoice" value="2"/>
        <var name="ActiveItemGrant" value="3"/>
        <var name="FragmentChoice" value="4"/>
    </enum>

    <enum name="RewardPoolKind">
        <var name="Dish" value="0"/>
        <var name="PassiveItem" value="1"/>
        <var name="ActiveItem" value="2"/>
        <var name="Fragment" value="3"/>
    </enum>

    <!-- sep="," 让 RecipeEntry 在单元格内按逗号分隔字段；list,RecipeEntry 按字段数循环切出元素。 -->
    <bean name="RecipeEntry" sep=",">
        <var name="dishId" type="string"/>
        <var name="weight" type="float"/>
        <var name="maxCount" type="int"/>
    </bean>

    <!-- 菜品本体：不随标签变化的物理属性。形状只在此写一次，被所有变体共享。 -->
    <bean name="DishBase">
        <var name="id" type="string"/>
        <var name="name" type="string"/>
        <var name="deliciousness" type="int"/>
        <var name="icon" type="string"/>
        <var name="allowRotate" type="bool"/>
        <var name="shapeRows" type="list,string"/>
    </bean>
    <table name="TbDishBase" value="DishBase" index="id" input="dish_base.xlsx"/>

    <!--
        菜品变体：真正的「随机菜品库」条目。引用本体 + 自带标签组合 + 自己的隐藏分/权重/价格。
        同一 baseId 的不同变体即「带不同标签视为不同菜品」。
        aTagId/bTagId 为空串表示该唯一标签槽位为空；inherentTags 放末列以支持多元素多行模式。
    -->
    <bean name="DishVariant">
        <var name="id" type="string"/>
        <var name="baseId" type="string"/>
        <var name="aTagId" type="string"/>
        <var name="bTagId" type="string"/>
        <var name="hiddenMin" type="int"/>
        <var name="hiddenMax" type="int"/>
        <var name="baseWeight" type="float"/>
        <var name="price" type="int"/>
        <var name="maxRollCount" type="int"/>
        <var name="inherentTags" type="list,string"/>
    </bean>
    <table name="TbDishVariant" value="DishVariant" index="id" input="dish_variant.xlsx"/>

    <!-- 标签（技能）。category 区分固有/唯一A/唯一B；termId 非空时菜品详情额外展示该名词。 -->
    <bean name="Tag">
        <var name="id" type="string"/>
        <var name="name" type="string"/>
        <var name="desc" type="string"/>
        <var name="category" type="TagCategory"/>
        <var name="effectType" type="TagEffectType"/>
        <var name="effectValue" type="float"/>
        <var name="effectParam" type="string"/>
        <var name="termId" type="string"/>
    </bean>
    <table name="TbTag" value="Tag" index="id" input="tag.xlsx"/>

    <!-- 专有名词：菜品详情右侧框单独解释。 -->
    <bean name="Term">
        <var name="id" type="string"/>
        <var name="name" type="string"/>
        <var name="desc" type="string"/>
    </bean>
    <table name="TbTerm" value="Term" index="id" input="term.xlsx"/>

    <!-- 角色：替换 Game 层硬编码占位列表。initialFragmentId 指向初始胃形状(碎片库)；maxStomachWidth/Height 为胃最大包围盒。 -->
    <bean name="Character">
        <var name="id" type="string"/>
        <var name="name" type="string"/>
        <var name="desc" type="string"/>
        <var name="portrait" type="string"/>
        <var name="initialRecipeId" type="string"/>
        <var name="initialFragmentId" type="string"/>
        <var name="maxStomachWidth" type="int"/>
        <var name="maxStomachHeight" type="int"/>
        <var name="startItems" type="list,string"/>
    </bean>
    <table name="TbCharacter" value="Character" index="id" input="character.xlsx"/>

    <!-- 胃部碎片库：也用作「初始胃」的形状来源。碎片不旋转(1x2 与 2x1 视为两个碎片)。'X'=存在格。 -->
    <bean name="StomachFragment">
        <var name="id" type="string"/>
        <var name="hiddenMin" type="int"/>
        <var name="hiddenMax" type="int"/>
        <var name="baseWeight" type="float"/>
        <var name="price" type="int"/>
        <var name="shapeRows" type="list,string"/>
    </bean>
    <table name="TbStomachFragment" value="StomachFragment" index="id" input="stomach_fragment.xlsx"/>

    <!-- 碎片格强化标签：分开配置。一行 = 碎片某格(x,y)挂一个标签 id（引用 TbTag）。 -->
    <bean name="FragmentCellTag">
        <var name="id" type="string"/>
        <var name="fragmentId" type="string"/>
        <var name="x" type="int"/>
        <var name="y" type="int"/>
        <var name="tagId" type="string"/>
    </bean>
    <table name="TbFragmentCellTag" value="FragmentCellTag" index="id" input="fragment_cell_tag.xlsx"/>

    <!-- 菜谱：固定菜品 + 加权放回随机池，随机到累计初始分 >= requiredInitScore 为止。 -->
    <bean name="Recipe">
        <var name="id" type="string"/>
        <var name="fixedDishes" type="list,string"/>
        <var name="pool" type="list,RecipeEntry"/>
        <var name="requiredInitScore" type="int"/>
    </bean>
    <table name="TbRecipe" value="Recipe" index="id" input="recipe.xlsx"/>

    <!--
        道具：被动常驻 / 主动可触发。
        specialTags 用 | 分隔多个标记，避免 Luban 多 list 字段限制；空串表示无特殊标记。
        acquireLimit/holdLimit <= 0 表示无限制；consumeOnUse 仅对主动道具生效。
    -->
    <bean name="Item">
        <var name="id" type="string"/>
        <var name="name" type="string"/>
        <var name="desc" type="string"/>
        <var name="kind" type="ItemKind"/>
        <var name="quality" type="ItemQuality"/>
        <var name="specialTags" type="string"/>
        <var name="maxLevel" type="int"/>
        <var name="nextLevelWeightMultiplier" type="float"/>
        <var name="unlockCondition" type="string"/>
        <var name="triggerTiming" type="ItemTriggerTiming"/>
        <var name="acquireLimit" type="int"/>
        <var name="holdLimit" type="int"/>
        <var name="consumeOnUse" type="bool"/>
        <var name="baseWeight" type="float"/>
        <var name="hiddenMin" type="int"/>
        <var name="hiddenMax" type="int"/>
        <var name="effectType" type="string"/>
        <var name="effectValue" type="float"/>
        <var name="effectParam" type="string"/>
        <var name="icon" type="string"/>
    </bean>
    <table name="TbItem" value="Item" index="id" input="item.xlsx"/>

    <!-- 目标分曲线：周/关卡引用它来生成本局要求分，无尽模式沿用最后一周的曲线增长。 -->
    <bean name="ScoreProfile">
        <var name="id" type="string"/>
        <var name="baseScore" type="int"/>
        <var name="difficultyMul" type="float"/>
        <var name="bossMul" type="float"/>
        <var name="endlessGrowthMul" type="float"/>
        <var name="roundTo" type="int"/>
    </bean>
    <table name="TbScoreProfile" value="ScoreProfile" index="id" input="score_profile.xlsx"/>

    <!-- 胜利奖励包：固定金币 + 主奖励槽组 + 可选额外奖励槽组。 -->
    <bean name="RewardPackage">
        <var name="id" type="string"/>
        <var name="goldMin" type="int"/>
        <var name="goldMax" type="int"/>
        <var name="mainSlotGroupId" type="string"/>
        <var name="extraSlotGroupId" type="string"/>
        <var name="extraChance" type="float"/>
        <var name="fallbackGold" type="int"/>
    </bean>
    <table name="TbRewardPackage" value="RewardPackage" index="id" input="reward_package.xlsx"/>

    <!-- 奖励槽：同 groupId 内按 weight 选一个槽，再按槽规则生成候选。 -->
    <bean name="RewardSlot">
        <var name="id" type="string"/>
        <var name="groupId" type="string"/>
        <var name="kind" type="RewardKind"/>
        <var name="choiceCount" type="int"/>
        <var name="weight" type="float"/>
        <var name="poolId" type="string"/>
        <var name="hiddenOffset" type="int"/>
        <var name="fallbackGold" type="int"/>
    </bean>
    <table name="TbRewardSlot" value="RewardSlot" index="id" input="reward_slot.xlsx"/>

    <!-- 奖励池筛选：qualityWeights 写 Common:70|Uncommon:25|Rare:5；specialTags 用 | 分隔。 -->
    <bean name="RewardPool">
        <var name="id" type="string"/>
        <var name="kind" type="RewardPoolKind"/>
        <var name="specialTags" type="string"/>
        <var name="qualityWeights" type="string"/>
        <var name="allowFallback" type="bool"/>
        <var name="distanceFloor" type="int"/>
    </bean>
    <table name="TbRewardPool" value="RewardPool" index="id" input="reward_pool.xlsx"/>

    <!-- 周/关卡：目标分、奖励包和隐藏分随进度推进；isBoss 为特殊天。 -->
    <bean name="Week">
        <var name="id" type="int"/>
        <var name="scoreProfileId" type="string"/>
        <var name="rewardPackageId" type="string"/>
        <var name="rewardHiddenScore" type="int"/>
        <var name="isBoss" type="bool"/>
        <var name="modifier" type="string"/>
    </bean>
    <table name="TbWeek" value="Week" index="id" input="week.xlsx"/>

    <!-- 三选一事件。 -->
    <bean name="GameEvent">
        <var name="id" type="string"/>
        <var name="name" type="string"/>
        <var name="desc" type="string"/>
        <var name="timeCost" type="int"/>
        <var name="effectType" type="string"/>
        <var name="effectValue" type="float"/>
    </bean>
    <table name="TbEvent" value="GameEvent" index="id" input="event.xlsx"/>
</module>
